# Caption Mirror environment variables (copy to .env.local and fill in).

# --- Supabase: required for hosted mode (deployed site AND `npm run dev` with this file present) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret key, sb_secret_... or legacy service_role>

# --- Analysis worker (`npm run worker`) + Vercel: shared secret, same value on both sides ---
WORKER_SECRET=<random 48-char hex: openssl rand -hex 24>

# --- Admin gate for /test/library and /results (set it in Vercel too; empty = gate disabled locally) ---
ADMIN_PASSWORD=<pick a password>

# --- Optional overrides ---
# SUPABASE_BUCKET=clips
# WORKER_PORT=8791
# WORKER_URL=https://<your-fixed-tunnel-url>          # use a fixed tunnel instead of the Cloudflare quick tunnel
# ANALYSIS_WORKER_URL=http://127.0.0.1:8791           # call a local worker directly, ignoring the heartbeat
# PYTHON=.venv/bin/python
# WHISPER_MODEL=small
